#!/usr/bin/env python3
"""tb - personal toolbox. Add a subcommand: write a function, register it in main()."""
import argparse, base64, datetime, http.server, json, socketserver, subprocess, sys


def ts(value=None):
    """No arg: now as epoch. Number: epoch -> ISO. Otherwise: ISO -> epoch."""
    if value is None:
        return str(int(datetime.datetime.now().timestamp()))
    try:
        n = float(value)
        if n > 1e11:  # milliseconds
            n /= 1000
        return datetime.datetime.fromtimestamp(n).astimezone().isoformat()
    except ValueError:
        return str(int(datetime.datetime.fromisoformat(value).timestamp()))


def b64(text, decode=False):
    if decode:
        return base64.b64decode(text).decode()
    return base64.b64encode(text.encode()).decode()


def main():
    p = argparse.ArgumentParser(prog="tb")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ts", help="epoch <-> ISO time")
    s.add_argument("value", nargs="?")

    s = sub.add_parser("b64", help="base64 encode/decode (reads stdin if no arg)")
    s.add_argument("text", nargs="?")
    s.add_argument("-d", "--decode", action="store_true")

    sub.add_parser("json", help="pretty-print JSON from stdin")

    s = sub.add_parser("port", help="show what's listening on a port")
    s.add_argument("port", type=int)

    s = sub.add_parser("serve", help="serve current dir over HTTP")
    s.add_argument("port", type=int, nargs="?", default=8000)

    a = p.parse_args()
    if a.cmd == "ts":
        print(ts(a.value))
    elif a.cmd == "b64":
        print(b64(a.text if a.text is not None else sys.stdin.read().strip(), a.decode))
    elif a.cmd == "json":
        print(json.dumps(json.load(sys.stdin), indent=2))
    elif a.cmd == "port":
        r = subprocess.run(["lsof", "-nP", f"-iTCP:{a.port}", "-sTCP:LISTEN"], capture_output=True, text=True)
        print(r.stdout or f"nothing listening on {a.port}")
    elif a.cmd == "serve":
        with socketserver.TCPServer(("", a.port), http.server.SimpleHTTPRequestHandler) as srv:
            print(f"http://localhost:{a.port}")
            srv.serve_forever()


if __name__ == "__main__":
    main()
